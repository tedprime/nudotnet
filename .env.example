# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Neon or Supabase Postgres) ---
# Pooled connection string, used by the app at runtime.
# Use `sslmode=verify-full` rather than `require` — functionally identical
# today, but avoids a pg-connection-string deprecation warning on every
# query (a future major version stops treating `require` as an alias for it).
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection string, used by Prisma Migrate.
# Do NOT add `channel_binding=require` here (Neon's dashboard sometimes
# includes it by default) — Prisma's migration engine fails to connect
# with it set, even though the app's own `pg` driver handles it fine.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Sessions ---
# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Cloudinary (staff/project photo uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Initial Super Admin (used once by `npm run db:seed`) ---
SEED_ADMIN_NAME="TedPrime Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Public base URL of the site, used to build the staff verification links
# shown on the admin "ID card" view (for writing to NFC cards).
NEXT_PUBLIC_SITE_URL="https://tedprime.net"
